{
  "name": "tings-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Configurable room information card for Home Assistant",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs && node scripts/config-reference.mjs --check && node --test tests/distribution.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "preview": "node scripts/serve.mjs",
    "package": "node scripts/package.mjs",
    "docs:config": "node scripts/config-reference.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "yaml": "2.9.1"
  }
}
